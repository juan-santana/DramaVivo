# ==============================================
# DramaApp — Environment Variables
# ==============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=dramaapp
MONGO_USERNAME=
MONGO_PASSWORD=

# --- Backend (Spring Boot) ---
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
JWT_EXPIRATION_HOURS=24
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=changeme123!

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api

# --- Scraper ---
SCRAPER_API_URL=http://localhost:8080/api/admin
SCRAPER_API_KEY=
SCRAPER_SCHEDULE_HOURS=6
SCRAPER_ALLOWED_DOMAINS=

# --- Video Provider ---
VIDEO_PROVIDER=local
# For cloud providers:
# VIDEO_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# CDN_BASE_URL=

# --- Ads (disabled until configured) ---
ADS_ENABLED=false
ADS_PROVIDER=
ADS_PUBLISHER_ID=
ADS_DISPLAY_SLOT_ID=
ADS_VIDEO_SLOT_ID=

# --- Docker ---
COMPOSE_PROJECT_NAME=dramaapp
